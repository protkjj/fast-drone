      </link>
      <plugin filename="FastDroneAero" name="fast_drone::AeroPlugin">
        <link_name>body</link_name>
        <csv_file>../data/aero_sized.csv</csv_file>
        <nose>1 0 0</nose>
        <right>0 -1 0</right>
        <wind>0 0 0</wind>
        <test_velocity_world>83.3 0 0</test_velocity_world>
        <test_omega_world>0 0 0</test_omega_world>
        <debug_csv>/tmp/fast_drone_aero/p5_highalpha.csv</debug_csv>
        <debug_csv_every>5</debug_csv_every>
