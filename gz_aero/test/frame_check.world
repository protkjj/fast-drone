          <inertia>
            <ixx>0.006040705941</ixx><iyy>0.04045326237</iyy><izz>0.04045326237</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="hull">
          <pose>0 0 0 0 1.5707963267948966 0</pose>
